---
export interface Props {
  title: string;
  description?: string;
  pageStyles?: string;
}

const {
  title,
  description = "Discover, compare, and choose the perfect software stack for your creative journey.",
  pageStyles = "",
} = Astro.props;
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Hanken+Grotesk:wght@100..900&family=Inter:wght@100..900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS via CDN (V2 design uses inline Tailwind config; CDN is intentional) -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "inverse-on-surface": "#332f39",
            "surface-container-lowest": "#100d16",
            "primary-container": "#7c3aed",
            "on-surface-variant": "#ccc3d8",
            "tertiary-container": "#a15100",
            "tertiary-fixed": "#ffdcc6",
            "surface-container": "#221e28",
            "surface-container-highest": "#37333e",
            "surface-container-high": "#2c2833",
            "surface-tint": "#d2bbff",
            "surface": "#15121b",
            "on-tertiary-container": "#ffe0cd",
            "on-secondary-fixed": "#001f26",
            "outline": "#958da1",
            "background": "#15121b",
            "primary": "#d2bbff",
            "on-tertiary": "#4f2500",
            "on-error-container": "#ffdad6",
            "on-error": "#690005",
            "on-secondary": "#003640",
            "error-container": "#93000a",
            "secondary": "#4cd7f6",
            "error": "#ffb4ab",
            "on-tertiary-fixed-variant": "#713700",
            "tertiary": "#ffb784",
            "on-primary-container": "#ede0ff",
            "tertiary-fixed-dim": "#ffb784",
            "on-primary-fixed-variant": "#5a00c6",
            "on-secondary-fixed-variant": "#004e5c",
            "secondary-fixed": "#acedff",
            "surface-variant": "#37333e",
            "secondary-container": "#03b5d3",
            "on-primary-fixed": "#25005a",
            "secondary-fixed-dim": "#4cd7f6",
            "on-background": "#e8dfee",
            "on-surface": "#e8dfee",
            "primary-fixed-dim": "#d2bbff",
            "primary-fixed": "#eaddff",
            "outline-variant": "#4a4455",
            "inverse-primary": "#732ee4",
            "on-primary": "#3f008e",
            "inverse-surface": "#e8dfee",
            "surface-bright": "#3c3742",
            "on-secondary-container": "#00424e",
            "on-tertiary-fixed": "#301400",
            "surface-dim": "#15121b",
            "surface-container-low": "#1d1a24",
          },
          borderRadius: {
            DEFAULT: "0.25rem",
            lg: "0.5rem",
            xl: "0.75rem",
            full: "9999px",
          },
          spacing: {
            "stack-md": "24px",
            "stack-sm": "12px",
            "margin-mobile": "20px",
            "stack-lg": "48px",
            "gutter": "24px",
            "container-max": "1280px",
            "unit": "8px",
            "margin-desktop": "64px",
          },
          fontFamily: {
            "mono-sm": ["Geist", "monospace"],
            "body-md": ["Inter", "sans-serif"],
            "label-md": ["Geist", "monospace"],
            "body-lg": ["Inter", "sans-serif"],
            "display-lg": ["Hanken Grotesk", "sans-serif"],
            "headline-md": ["Hanken Grotesk", "sans-serif"],
            "display-lg-mobile": ["Hanken Grotesk", "sans-serif"],
            "headline-lg": ["Hanken Grotesk", "sans-serif"],
          },
          fontSize: {
            "mono-sm": ["12px", { lineHeight: "1.5", fontWeight: "400" }],
            "body-md": ["16px", { lineHeight: "1.6", fontWeight: "400" }],
            "label-md": ["14px", { lineHeight: "1.2", letterSpacing: "0.05em", fontWeight: "500" }],
            "body-lg": ["18px", { lineHeight: "1.6", fontWeight: "400" }],
            "display-lg": ["64px", { lineHeight: "1.1", letterSpacing: "-0.02em", fontWeight: "800" }],
            "headline-md": ["24px", { lineHeight: "1.4", fontWeight: "600" }],
            "display-lg-mobile": ["40px", { lineHeight: "1.2", letterSpacing: "-0.02em", fontWeight: "800" }],
            "headline-lg": ["32px", { lineHeight: "1.3", fontWeight: "700" }],
          },
        },
      },
    };
  </script>

  <!-- Base global V2 styles -->
  <style>
    body {
      background-color: #0D1117;
      color: #e8dfee;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .glass-panel {
      background: rgba(22, 27, 34, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .glass-card {
      background: #161B22;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s ease;
    }

    .glass-card:hover {
      transform: scale(1.02);
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 10px 30px -10px rgba(124, 58, 237, 0.1);
    }

    .primary-gradient-text {
      background: linear-gradient(135deg, #7C3AED, #06B6D4);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .gradient-text {
      background: linear-gradient(to right, #d2bbff, #4cd7f6);
      -webkit-background-clip: text;
      color: transparent;
    }

    .text-gradient {
      background: linear-gradient(135deg, #d2bbff 0%, #4cd7f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .primary-btn {
      background: linear-gradient(135deg, #7C3AED, #06B6D4);
      transition: all 0.3s ease;
      box-shadow: 0 4px 20px rgba(124, 58, 237, 0.2);
    }

    .primary-btn:hover {
      background: linear-gradient(135deg, #8B5CF6, #06B6D4);
      box-shadow: 0 8px 30px rgba(124, 58, 237, 0.3);
    }

    .primary-gradient-btn {
      background: linear-gradient(135deg, #7c3aed 0%, #03b5d3 100%);
      box-shadow: 0 8px 32px rgba(124, 58, 237, 0.2);
      transition: all 0.3s ease;
    }

    .primary-gradient-btn:hover {
      background: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%);
      box-shadow: 0 12px 40px rgba(124, 58, 237, 0.3);
    }

    .secondary-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s ease;
    }

    .secondary-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .secondary-ghost-btn {
      background: transparent;
      border: 1px solid #8B949E;
      transition: all 0.3s ease;
    }

    .secondary-ghost-btn:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .glow-shadow {
      box-shadow: 0 0 30px rgba(124, 58, 237, 0.2);
    }

    .input-glow:focus-within {
      border-color: #7C3AED;
      box-shadow: 0 0 15px rgba(124, 58, 237, 0.3);
    }

    .section-spacing {
      margin-top: 128px;
      margin-bottom: 128px;
    }

    @media (max-width: 768px) {
      .section-spacing {
        margin-top: 80px;
        margin-bottom: 80px;
      }
    }

    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .material-symbols-outlined[data-weight="fill"] {
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
  </style>

  <!-- Per-page styles injected via slot -->
  {pageStyles && <style set:html={pageStyles} />}
</head>
<body class="font-body-md text-body-md overflow-x-hidden antialiased">
  <slot />
</body>
</html>
