---
// Shared Navbar Component
const pathname = Astro.url.pathname;
const normalizedPathname = pathname.length > 1 && pathname.endsWith('/') 
  ? pathname.slice(0, -1) 
  : pathname;

const isDiscover = normalizedPathname === '/' || normalizedPathname === '/index.html';
const isIndustries = normalizedPathname === '/career' || normalizedPathname.startsWith('/career/') || normalizedPathname.startsWith('/careers');
const isBlueprints = normalizedPathname === '/blueprint' || normalizedPathname.startsWith('/blueprint/');
const isSoftware = normalizedPathname === '/software' || normalizedPathname.startsWith('/software/');
const isCompare = normalizedPathname === '/compare' || normalizedPathname.startsWith('/compare/');
const isResources = normalizedPathname === '/resources' || normalizedPathname.startsWith('/resources/');

const activeClass = "text-primary font-bold border-b-2 border-primary pb-1 text-label-md font-label-md";
const inactiveClass = "text-on-surface-variant hover:text-on-surface transition-colors text-label-md font-label-md";
---
<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 bg-surface/70 backdrop-blur-xl border-b border-white/5 shadow-primary/20 shadow-2xl">
<div class="flex justify-between items-center h-20 px-margin-desktop max-w-container-max mx-auto">
<a href="/" class="flex items-center gap-4">
<img alt="Tech Soul Logo" class="h-10 w-auto object-contain" src="/images/tech_soul_logo.png"/>
<span class="font-headline-md text-headline-md font-bold text-on-surface">Tech Soul</span>
</a>
<div class="hidden md:flex items-center gap-stack-md"><a class={isDiscover ? activeClass : inactiveClass} href="/">Discover</a><a class={isIndustries ? activeClass : inactiveClass} href="/careers">Industries</a><a class={isBlueprints ? activeClass : inactiveClass} href="/blueprint">Blueprints</a><a class={isSoftware ? activeClass : inactiveClass} href="/software">Software</a><a class={isCompare ? activeClass : inactiveClass} href="/compare">Compare</a><a class={isResources ? activeClass : inactiveClass} href="/resources">Resources</a></div>
<div class="flex items-center gap-4">
<button class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-all">search</button>
</div>
</div>
</nav>
<script>
        // Scroll effect for navbar height transition
        document.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (nav) {
                if (window.scrollY > 50) {
                    nav.classList.add('py-2');
                    nav.classList.remove('h-20');
                    nav.classList.add('h-16');
                } else {
                    nav.classList.remove('py-2');
                    nav.classList.add('h-20');
                    nav.classList.remove('h-16');
                }
            }
        });
</script>
