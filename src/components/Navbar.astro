---
const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Discover', href: '/' },
  { name: 'Software', href: '/software' },
  { name: 'Compare', href: '/compare' },
  { name: 'Blueprints', href: '/blueprint' },
  { name: 'AI Tools', href: '/ai-tools' },
  { name: 'Resources', href: '/resources' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname === href || pathname.startsWith(href + '/');
}
---
<!-- Top Navigation Bar -->
<nav class="fixed top-0 w-full z-50 bg-surface/70 dark:bg-surface/70 backdrop-blur-xl border-b border-white/5 shadow-primary/20 shadow-xl transition-all duration-300">
  <div class="flex justify-between items-center h-20 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Brand -->
    <a href="/" class="text-headline-md font-headline-md font-bold text-on-surface dark:text-on-surface flex items-center gap-2 group hover:opacity-90 transition-all">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-surface font-black shadow-[0_0_15px_rgba(124,58,237,0.3)]">
        TS
      </div>
      <span>Tech Soul</span>
    </a>

    <!-- Navigation Links (Desktop) -->
    <div class="hidden md:flex items-center gap-6">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={
              active
                ? "font-label-md text-label-md text-primary font-bold border-b-2 border-primary pb-1 transition-all duration-200"
                : "font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all duration-200"
            }
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <button class="text-on-surface-variant hover:text-on-surface transition-colors active:scale-95 flex items-center justify-center p-2 rounded-full glass-panel" aria-label="Search">
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">search</span>
      </button>
      <a
        href="/compare"
        class="hidden md:inline-flex items-center justify-center px-6 py-2.5 rounded-lg bg-gradient-to-r from-primary-container to-secondary-container text-white font-label-md text-label-md font-bold hover:brightness-110 shadow-[0_0_15px_rgba(124,58,237,0.3)] transition-all active:scale-95 duration-100"
      >
        Compare
      </a>
    </div>
  </div>
</nav>
