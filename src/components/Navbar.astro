---
const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname.startsWith(path);
};
---
<nav class="fixed top-0 w-full z-50 bg-surface/70 backdrop-blur-xl border-b border-white/5 shadow-primary/20 shadow-xl transition-all duration-300">
  <div class="flex justify-between items-center h-16 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <!-- Brand -->
    <a class="flex items-center gap-2 font-headline-md text-headline-md font-bold text-on-surface hover:opacity-80 transition-all duration-300 active:scale-95" href="/">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-surface font-black text-sm">TS</div>
      <span>Tech Soul</span>
    </a>
    <!-- Desktop Nav -->
    <div class="hidden md:flex items-center gap-gutter">
      <a class={`font-label-md text-label-md transition-all duration-300 active:scale-95 ${isActive('/') && !isActive('/software') && !isActive('/blueprint') ? 'text-primary font-bold border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-on-surface'}`} href="/">Discover</a>
      <a class={`font-label-md text-label-md transition-all duration-300 active:scale-95 ${isActive('/software') ? 'text-primary font-bold border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-on-surface'}`} href="/software">Software</a>
      <a class={`font-label-md text-label-md transition-all duration-300 active:scale-95 ${isActive('/blueprint') ? 'text-primary font-bold border-b-2 border-primary pb-1' : 'text-on-surface-variant hover:text-on-surface'}`} href="/blueprint">Blueprints</a>
      <a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all duration-300 active:scale-95" href="#">Guides</a>
    </div>
    <!-- Actions -->
    <div class="flex items-center gap-4">
      <button class="text-on-surface-variant hover:text-on-surface transition-colors active:scale-95 flex items-center justify-center p-2 rounded-full glass-panel">
        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0;">search</span>
      </button>
    </div>
  </div>
</nav>
