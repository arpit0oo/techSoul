---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Tech Soul | Platform &amp; Priorities</title>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Inter:wght@400;500&family=Geist:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
        body {
            background-color: #0D1117;
            color: #e8dfee;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(22, 27, 34, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .segmented-control-bg {
            background: rgba(13, 17, 23, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .active-segment {
            background: #d2bbff;
            color: #3f008e;
            box-shadow: 0 0 20px rgba(210, 187, 255, 0.3);
        }
        .priority-chip {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .priority-chip.active {
            background: rgba(124, 58, 237, 0.2);
            border-color: #7c3aed;
            box-shadow: 0 0 15px rgba(124, 58, 237, 0.4);
            color: #d2bbff;
        }
        .progress-glow {
            box-shadow: 0 0 12px #d2bbff;
        }
        .cta-gradient {
            background: linear-gradient(135deg, #7c3aed 0%, #4cd7f6 100%);
            transition: transform 0.2s, filter 0.2s;
        }
        .cta-gradient:hover {
            transform: scale(1.02);
            filter: brightness(1.1);
        }
        .cta-gradient:active {
            transform: scale(0.98);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            vertical-align: middle;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }
        .shake { animation: shake 0.2s cubic-bezier(.36,.07,.19,.97) both; }
</style>
</head>
<body class="font-body-md text-body-md antialiased bg-background text-on-surface">
<Navbar />
<main class="pt-32 pb-stack-lg min-h-screen flex flex-col items-center">
<!-- Progress Bar Section -->
<div class="w-full max-w-2xl px-margin-mobile mb-stack-lg">
<div class="flex justify-between items-end mb-4">
<span class="font-label-md text-label-md text-primary uppercase tracking-widest">Step 5 of 5</span>
<span class="font-label-md text-label-md text-on-surface-variant">Finalizing Blueprint</span>
</div>
<div class="h-1 w-full bg-surface-container-highest rounded-full overflow-hidden">
<div class="h-full bg-primary progress-glow transition-all duration-1000 ease-out" style="width: 100%;"></div>
</div>
</div>
<!-- Content Canvas -->
<div class="w-full max-w-4xl px-margin-mobile space-y-stack-lg">
<!-- Hero Header -->
<header class="text-center space-y-4">
<h1 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface">
                    Tailor your <span class="text-primary">Toolkit.</span>
</h1>
<p class="text-on-surface-variant max-w-xl mx-auto font-body-lg text-body-lg">
                    We're almost there. Define your environment and your non-negotiables to generate your professional software blueprint.
                </p>
</header>
<div class="grid grid-cols-1 md:grid-cols-1 gap-12 pt-8">
<!-- Platform Selection -->
<section class="space-y-6">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-primary">devices</span>
<h2 class="font-headline-md text-headline-md">Which platform do you use?</h2>
</div>
<div class="segmented-control-bg p-1.5 rounded-xl flex w-full md:max-w-2xl mx-auto">
<button class="flex-1 py-4 px-6 rounded-lg font-label-md text-label-md transition-all duration-300 flex items-center justify-center gap-2 text-on-surface-variant active-segment" data-platform="windows" onclick="togglePlatform(this)">
<span class="material-symbols-outlined">window</span> Windows
                        </button>
<button class="flex-1 py-4 px-6 rounded-lg font-label-md text-label-md transition-all duration-300 flex items-center justify-center gap-2 text-on-surface-variant" data-platform="macos" onclick="togglePlatform(this)">
<span class="material-symbols-outlined">laptop_mac</span> macOS
                        </button>
<button class="flex-1 py-4 px-6 rounded-lg font-label-md text-label-md transition-all duration-300 flex items-center justify-center gap-2 text-on-surface-variant" data-platform="linux" onclick="togglePlatform(this)">
<span class="material-symbols-outlined">terminal</span> Linux
                        </button>
</div>
</section>
<!-- Priorities Section -->
<section class="space-y-6">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-tertiary">star</span>
<h2 class="font-headline-md text-headline-md">What matters most?</h2>
</div>
<p class="text-on-surface-variant font-body-md">Select up to 3 core priorities for your workflow.</p>
<div class="flex flex-wrap gap-4 justify-center">
<button class="priority-chip group flex items-center gap-3 px-6 py-4 rounded-xl border border-white/10 glass-panel" onclick="togglePriority(this)">
<span class="material-symbols-outlined text-secondary transition-transform group-hover:scale-110">bolt</span>
<span class="font-label-md text-label-md">Speed</span>
</button>
<button class="priority-chip group flex items-center gap-3 px-6 py-4 rounded-xl border border-white/10 glass-panel" onclick="togglePriority(this)">
<span class="material-symbols-outlined text-primary transition-transform group-hover:scale-110">neurology</span>
<span class="font-label-md text-label-md">AI Features</span>
</button>
<button class="priority-chip group flex items-center gap-3 px-6 py-4 rounded-xl border border-white/10 glass-panel active" onclick="togglePriority(this)">
<span class="material-symbols-outlined text-tertiary transition-transform group-hover:scale-110">work_outline</span>
<span class="font-label-md text-label-md">Professional Workflow</span>
</button>
<button class="priority-chip group flex items-center gap-3 px-6 py-4 rounded-xl border border-white/10 glass-panel" onclick="togglePriority(this)">
<span class="material-symbols-outlined text-secondary-fixed-dim transition-transform group-hover:scale-110">payments</span>
<span class="font-label-md text-label-md">Budget</span>
</button>
<button class="priority-chip group flex items-center gap-3 px-6 py-4 rounded-xl border border-white/10 glass-panel" onclick="togglePriority(this)">
<span class="material-symbols-outlined text-error transition-transform group-hover:scale-110">school</span>
<span class="font-label-md text-label-md">Ease of Learning</span>
</button>
<button class="priority-chip group flex items-center gap-3 px-6 py-4 rounded-xl border border-white/10 glass-panel" onclick="togglePriority(this)">
<span class="material-symbols-outlined text-on-secondary-container transition-transform group-hover:scale-110">verified</span>
<span class="font-label-md text-label-md">Industry Standard</span>
</button>
</div>
</section>
<!-- CTA Section -->
<div class="flex flex-col items-center pt-8 space-y-6">
<button class="cta-gradient w-full max-w-md py-6 px-12 rounded-full font-headline-md text-headline-md text-white shadow-2xl flex items-center justify-center gap-3 group relative overflow-hidden" onclick="window.location.href='/blueprint/result'">
<span class="relative z-10">Generate My Blueprint</span>
<span class="material-symbols-outlined relative z-10 group-hover:translate-x-1 transition-transform">auto_awesome</span>
<div class="absolute inset-0 bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity"></div>
</button>
<p class="text-on-surface-variant font-label-md flex items-center gap-2">
<span class="material-symbols-outlined text-sm">lock</span> 
                        Your preferences are analyzed locally for privacy.
                    </p>
</div>
</div>
</div>
</main>
<Footer />
<script is:inline>
        function togglePlatform(btn) {
            const buttons = btn.parentElement.querySelectorAll('button');
            buttons.forEach(b => {
                b.classList.remove('active-segment');
                b.classList.add('text-on-surface-variant');
            });
            btn.classList.add('active-segment');
            btn.classList.remove('text-on-surface-variant');
            
            btn.style.transform = 'scale(0.95)';
            setTimeout(() => {
                btn.style.transform = 'scale(1)';
            }, 100);
        }

        function togglePriority(btn) {
            const activeChips = document.querySelectorAll('.priority-chip.active');
            
            if (btn.classList.contains('active')) {
                btn.classList.remove('active');
            } else {
                if (activeChips.length < 3) {
                    btn.classList.add('active');
                } else {
                    btn.classList.add('shake');
                    setTimeout(() => btn.classList.remove('shake'), 500);
                }
            }
        }
</script>
</body>
</html>
