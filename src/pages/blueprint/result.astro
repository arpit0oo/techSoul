---
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Your Tech Soul Blueprint</title>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Inter:wght@400;500;600&family=Geist:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
        body {
            background-color: #15121b;
            color: #e8dfee;
            -webkit-font-smoothing: antialiased;
        }
        .glass-panel {
            background: rgba(22, 27, 34, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .text-gradient-primary {
            background: linear-gradient(135deg, #d2bbff 0%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .card-hover-effect {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .card-hover-effect:hover {
            transform: translateY(-4px) scale(1.02);
            border-color: rgba(210, 187, 255, 0.4);
            box-shadow: 0 20px 40px -20px rgba(124, 58, 237, 0.3);
        }
        .blueprint-path-line {
            background: linear-gradient(90deg, #7c3aed 0%, transparent 100%);
        }
        @keyframes pulse-subtle {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .animate-pulse-slow {
            animation: pulse-subtle 4s infinite ease-in-out;
        }
</style>
</head>
<body class="font-body-md text-on-surface bg-background">
<Navbar />
<main class="pt-32 pb-stack-lg">
<div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
<!-- Hero Header -->
<header class="mb-stack-lg text-center md:text-left relative">
<div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-gradient-primary mb-stack-sm">Your Tech Soul Blueprint</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">Based on your unique creative fingerprint, we've synthesized a professional roadmap designed to elevate your craft.</p>
</header>
<!-- Section 1: Celebration & Summary -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-stack-lg">
<div class="glass-panel p-stack-md rounded-xl flex flex-col items-center justify-center text-center">
<div class="w-32 h-32 relative flex items-center justify-center mb-stack-sm">
<svg class="absolute inset-0 w-full h-full transform -rotate-90">
<circle class="text-surface-container-highest" cx="64" cy="64" fill="transparent" r="58" stroke="currentColor" stroke-width="8"></circle>
<circle class="text-primary" cx="64" cy="64" fill="transparent" r="58" stroke="currentColor" stroke-dasharray="364.4" stroke-dashoffset="7" stroke-width="8"></circle>
</svg>
<span class="font-headline-lg text-headline-lg score-display">9.8</span>
</div>
<p class="font-label-md text-label-md text-primary uppercase tracking-widest">Blueprint Score</p>
</div>
<div class="glass-panel p-stack-md rounded-xl flex flex-col items-center justify-center text-center">
<div class="text-primary mb-stack-sm">
<span class="material-symbols-outlined text-5xl" style="font-variation-settings: 'FILL' 1;">timer</span>
</div>
<span class="font-headline-lg text-headline-lg">45 mins</span>
<p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">Estimated Setup</p>
</div>
<div class="glass-panel p-stack-md rounded-xl flex flex-col items-center justify-center text-center">
<div class="text-tertiary mb-stack-sm">
<span class="material-symbols-outlined text-5xl" style="font-variation-settings: 'FILL' 1;">trending_up</span>
</div>
<span class="font-headline-lg text-headline-lg">High</span>
<p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">Career Readiness</p>
</div>
</section>
<!-- Section 2: Recommended Software -->
<section class="mb-stack-lg">
<div class="flex items-end justify-between mb-stack-md">
<h2 class="font-headline-lg text-headline-lg">Recommended Software</h2>
<span class="font-label-md text-label-md text-on-surface-variant">6 Tools Selected</span>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
<!-- Tool Card 1 -->
<div class="glass-panel p-6 rounded-xl card-hover-effect flex flex-col gap-4">
<div class="flex justify-between items-start">
<div class="w-14 h-14 bg-surface-container-highest rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">brush</span>
</div>
<div class="bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
<span class="font-mono-sm text-mono-sm text-primary">Score: 9.9</span>
</div>
</div>
<div>
<h3 class="font-headline-md text-headline-md">Photoshop</h3>
<p class="font-body-md text-on-surface-variant mt-2 italic text-sm">"Why it fits you: Your focus on digital texture and pixel-perfect retouching demands the industry standard for raster manipulation."</p>
</div>
</div>
<!-- Tool Card 2 -->
<div class="glass-panel p-6 rounded-xl card-hover-effect flex flex-col gap-4">
<div class="flex justify-between items-start">
<div class="w-14 h-14 bg-surface-container-highest rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">architecture</span>
</div>
<div class="bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
<span class="font-mono-sm text-mono-sm text-primary">Score: 9.7</span>
</div>
</div>
<div>
<h3 class="font-headline-md text-headline-md">Illustrator</h3>
<p class="font-body-md text-on-surface-variant mt-2 italic text-sm">"Why it fits you: Essential for the scalable vector branding and complex iconography you mentioned in your profile."</p>
</div>
</div>
<!-- Tool Card 3 -->
<div class="glass-panel p-6 rounded-xl card-hover-effect flex flex-col gap-4">
<div class="flex justify-between items-start">
<div class="w-14 h-14 bg-surface-container-highest rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">font_download</span>
</div>
<div class="bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
<span class="font-mono-sm text-mono-sm text-primary">Score: 9.5</span>
</div>
</div>
<div>
<h3 class="font-headline-md text-headline-md">Adobe Fonts</h3>
<p class="font-body-md text-on-surface-variant mt-2 italic text-sm">"Why it fits you: Since you prioritize editorial layouts, access to premium foundries is non-negotiable."</p>
</div>
</div>
<!-- Tool Card 4 -->
<div class="glass-panel p-6 rounded-xl card-hover-effect flex flex-col gap-4">
<div class="flex justify-between items-start">
<div class="w-14 h-14 bg-surface-container-highest rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">palette</span>
</div>
<div class="bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
<span class="font-mono-sm text-mono-sm text-primary">Score: 9.2</span>
</div>
</div>
<div>
<h3 class="font-headline-md text-headline-md">Coolors</h3>
<p class="font-body-md text-on-surface-variant mt-2 italic text-sm">"Why it fits you: Rapid prototyping of harmonized palettes matches your high-velocity workflow style."</p>
</div>
</div>
<!-- Tool Card 5 -->
<div class="glass-panel p-6 rounded-xl card-hover-effect flex flex-col gap-4">
<div class="flex justify-between items-start">
<div class="w-14 h-14 bg-surface-container-highest rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">layers_clear</span>
</div>
<div class="bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
<span class="font-mono-sm text-mono-sm text-primary">Score: 9.1</span>
</div>
</div>
<div>
<h3 class="font-headline-md text-headline-md">Remove.bg</h3>
<p class="font-body-md text-on-surface-variant mt-2 italic text-sm">"Why it fits you: Automates repetitive background removal, freeing you for deeper conceptual work."</p>
</div>
</div>
<!-- Tool Card 6 -->
<div class="glass-panel p-6 rounded-xl card-hover-effect flex flex-col gap-4">
<div class="flex justify-between items-start">
<div class="w-14 h-14 bg-surface-container-highest rounded-lg flex items-center justify-center">
<span class="material-symbols-outlined text-primary text-3xl">text_fields</span>
</div>
<div class="bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
<span class="font-mono-sm text-mono-sm text-primary">Score: 8.8</span>
</div>
</div>
<div>
<h3 class="font-headline-md text-headline-md">Google Fonts</h3>
<p class="font-body-md text-on-surface-variant mt-2 italic text-sm">"Why it fits you: Perfect for web-ready implementation of the identities you build in Illustrator."</p>
</div>
</div>
</div>
</section>
<!-- Section 3: Workflow Roadmap -->
<section class="mb-stack-lg">
<div class="glass-panel p-stack-md rounded-2xl overflow-hidden relative">
<div class="absolute top-0 right-0 w-1/3 h-full opacity-20">
</div>
<h2 class="font-headline-lg text-headline-lg mb-stack-md relative z-10">Workflow Roadmap</h2>
<div class="relative flex flex-col md:flex-row justify-between items-center gap-8 py-8 z-10">
<div class="absolute hidden md:block top-1/2 left-0 w-full h-[2px] blueprint-path-line -translate-y-1/2 -z-10"></div>
<div class="flex flex-col items-center group">
<div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center shadow-lg shadow-primary/20 mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-on-primary text-3xl">lightbulb</span>
</div>
<span class="font-label-md text-label-md">Idea</span>
</div>
<div class="flex flex-col items-center group">
<div class="w-16 h-16 rounded-full bg-surface-container-high border-2 border-primary/40 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-primary text-3xl">edit</span>
</div>
<span class="font-label-md text-label-md">Design</span>
</div>
<div class="flex flex-col items-center group">
<div class="w-16 h-16 rounded-full bg-surface-container-high border-2 border-primary/40 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-primary text-3xl">auto_fix_high</span>
</div>
<span class="font-label-md text-label-md">Edit</span>
</div>
<div class="flex flex-col items-center group">
<div class="w-16 h-16 rounded-full bg-surface-container-high border-2 border-primary/40 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-primary text-3xl">file_export</span>
</div>
<span class="font-label-md text-label-md">Export</span>
</div>
<div class="flex flex-col items-center group">
<div class="w-16 h-16 rounded-full bg-surface-container-high border-2 border-primary/40 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-primary text-3xl">work_outline</span>
</div>
<span class="font-label-md text-label-md">Portfolio</span>
</div>
</div>
</div>
</section>
<!-- Section 4: Learning Path -->
<section class="mb-stack-lg">
<h2 class="font-headline-lg text-headline-lg mb-stack-md">Career Learning Path</h2>
<div class="overflow-x-auto pb-4">
<div class="flex gap-4 min-w-[900px]">
<div class="flex-1 bg-surface-container-low p-6 rounded-xl border border-white/5">
<div class="text-primary font-mono-sm text-mono-sm mb-2">WEEK 1</div>
<h4 class="font-headline-md text-headline-md mb-2">Foundation</h4>
<p class="text-sm text-on-surface-variant">Master core interface navigation in Photoshop and Illustrator.</p>
</div>
<div class="flex-1 bg-surface-container-low p-6 rounded-xl border border-white/5">
<div class="text-primary font-mono-sm text-mono-sm mb-2">WEEK 2</div>
<h4 class="font-headline-md text-headline-md mb-2">Synthesis</h4>
<p class="text-sm text-on-surface-variant">Combining raster and vector assets for complex brand identities.</p>
</div>
<div class="flex-1 bg-surface-container-low p-6 rounded-xl border border-white/5">
<div class="text-primary font-mono-sm text-mono-sm mb-2">WEEK 3</div>
<h4 class="font-headline-md text-headline-md mb-2">Automation</h4>
<p class="text-sm text-on-surface-variant">Integrating AI background removal and typography automation.</p>
</div>
<div class="flex-1 bg-surface-container-low p-6 rounded-xl border border-white/5">
<div class="text-primary font-mono-sm text-mono-sm mb-2">WEEK 4</div>
<h4 class="font-headline-md text-headline-md mb-2">Portfolio</h4>
<p class="text-sm text-on-surface-variant">Building a case study around your optimized workflow.</p>
</div>
<div class="flex-1 bg-primary-container p-6 rounded-xl shadow-xl shadow-primary/10">
<div class="text-on-primary-container font-mono-sm text-mono-sm mb-2">CAREER GOAL</div>
<h4 class="font-headline-md text-headline-md mb-2">Job Ready</h4>
<p class="text-sm text-on-primary-container/80">Full competency in professional creative pipelines.</p>
</div>
</div>
</div>
</section>
<!-- Section 5: Final Actions -->
<section class="flex flex-col md:flex-row items-center justify-center gap-gutter pt-stack-md border-t border-white/5">
<button class="w-full md:w-auto px-10 py-4 rounded-full bg-gradient-to-r from-primary to-inverse-primary text-on-primary font-bold active:scale-95 transition-transform shadow-lg shadow-primary/20">
                    Save Blueprint
                </button>
<button class="w-full md:w-auto px-10 py-4 rounded-full bg-transparent border border-outline text-on-surface font-semibold hover:bg-white/5 active:scale-95 transition-all" onclick="window.location.href='/software'">
                    Explore Software
                </button>
<button class="w-full md:w-auto px-10 py-4 rounded-full bg-transparent border border-outline text-on-surface font-semibold hover:bg-white/5 active:scale-95 transition-all" onclick="window.location.href='/compare'">
                    Compare Tools
                </button>
</section>
</div>
</main>
<Footer />
<script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const scoreElement = document.querySelector('.score-display');
            if (scoreElement && scoreElement.innerText === '9.8') {
                let current = 0;
                const target = 9.8;
                const duration = 2000;
                const increment = target / (duration / 16);
                
                const animate = () => {
                    current += increment;
                    if (current < target) {
                        scoreElement.innerText = current.toFixed(1);
                        requestAnimationFrame(animate);
                    } else {
                        scoreElement.innerText = target.toFixed(1);
                    }
                };
                animate();
            }
        });
</script>
</body>
</html>
