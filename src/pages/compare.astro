---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Tech Soul | Photoshop vs CorelDRAW Comparison</title>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;700;800&family=Inter:wght@400;500&family=Geist:wght@400;500&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<style>
        body {
            background-color: #0D1117;
            color: #e8dfee;
            -webkit-font-smoothing: antialiased;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }
        .glass-panel {
            background: rgba(22, 27, 34, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .gradient-text {
            background: linear-gradient(135deg, #d2bbff 0%, #7C3AED 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .shimmer-hover:hover {
            border-color: rgba(124, 58, 237, 0.5);
            box-shadow: 0 0 30px rgba(124, 58, 237, 0.15);
            transform: translateY(-4px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .vs-badge {
            background: linear-gradient(135deg, #7C3AED 0%, #5a00c6 100%);
            box-shadow: 0 0 40px rgba(124, 58, 237, 0.4);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #0D1117;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #37333e;
            border-radius: 10px;
        }
</style>
</head>
<body class="font-body-md text-body-md overflow-x-hidden bg-background text-on-surface">

    <Navbar />

    <main class="pt-20">
        <!-- Hero Section -->
        <section class="relative overflow-hidden py-stack-lg min-h-[819px] flex items-center">
            <div class="absolute inset-0 w-full h-full opacity-30 pointer-events-none"></div>
            <div class="max-w-container-max mx-auto px-margin-desktop relative z-10 w-full">
                <div class="text-center mb-16">
                    <span class="font-label-md text-label-md text-primary tracking-widest uppercase mb-4 block">Head to Head Battle</span>
                    <h1 class="font-display-lg text-display-lg mb-6 max-w-4xl mx-auto">Software Comparison</h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">An in-depth analysis of the world's most powerful creative suites. Find your perfect workflow match.</p>
                </div>

                <div class="flex flex-col md:flex-row items-center justify-between gap-12 lg:gap-0">
                    <!-- Photoshop Card -->
                    <div class="w-full md:w-[42%] group">
                        <div class="glass-panel p-10 rounded-xl shimmer-hover">
                            <div class="flex items-center gap-6 mb-8">
                                <div class="w-20 h-20 bg-[#001E36] rounded-xl flex items-center justify-center border border-[#00A8FF]/20">
                                    <span class="text-4xl font-bold text-[#00A8FF]">Ps</span>
                                </div>
                                <div>
                                    <h2 class="font-headline-lg text-headline-lg">Photoshop</h2>
                                    <span class="font-label-md text-label-md text-on-surface-variant">Industry Standard</span>
                                </div>
                            </div>
                            <p class="text-on-surface-variant mb-8 leading-relaxed">The undisputed king of pixel-perfect manipulation, AI-powered generation, and professional retouching workflows.</p>
                            <div class="flex flex-wrap gap-2">
                                <span class="bg-primary/10 text-primary px-3 py-1 rounded-full font-mono-sm text-mono-sm">Generative AI</span>
                                <span class="bg-primary/10 text-primary px-3 py-1 rounded-full font-mono-sm text-mono-sm">Photo Editing</span>
                            </div>
                        </div>
                    </div>

                    <!-- VS Badge -->
                    <div class="vs-badge w-24 h-24 rounded-full flex items-center justify-center text-white font-display-lg-mobile text-display-lg-mobile z-20 shrink-0">
                        VS
                    </div>

                    <!-- CorelDRAW Card -->
                    <div class="w-full md:w-[42%] group">
                        <div class="glass-panel p-10 rounded-xl shimmer-hover">
                            <div class="flex items-center gap-6 mb-8">
                                <div class="w-20 h-20 bg-[#2B2B2B] rounded-xl flex items-center justify-center border border-[#64B448]/20">
                                    <span class="text-4xl font-bold text-[#64B448]">Cd</span>
                                </div>
                                <div>
                                    <h2 class="font-headline-lg text-headline-lg">CorelDRAW</h2>
                                    <span class="font-label-md text-label-md text-on-surface-variant">Vector Powerhouse</span>
                                </div>
                            </div>
                            <p class="text-on-surface-variant mb-8 leading-relaxed">A versatile suite optimized for large-scale printing, technical drawing, and complex vector illustrations with total control.</p>
                            <div class="flex flex-wrap gap-2">
                                <span class="bg-secondary-container/20 text-secondary px-3 py-1 rounded-full font-mono-sm text-mono-sm">Print Ready</span>
                                <span class="bg-secondary-container/20 text-secondary px-3 py-1 rounded-full font-mono-sm text-mono-sm">Vector Design</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Decision Section -->
        <section class="py-stack-lg bg-surface-container-low">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <div class="mb-stack-md">
                    <h2 class="font-headline-lg text-headline-lg mb-2">Which one should I choose?</h2>
                    <p class="text-on-surface-variant">Select your persona to see our direct recommendation.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
                    <!-- Persona 1 -->
                    <div class="glass-panel p-8 rounded-xl shimmer-hover flex flex-col h-full">
                        <span class="material-symbols-outlined text-primary mb-6 text-4xl" data-icon="brush">brush</span>
                        <h3 class="font-headline-md text-headline-md mb-2">Graphic Designer</h3>
                        <p class="text-on-surface-variant flex-grow mb-6">Social media, web assets, and high-end visual compositing.</p>
                        <div class="pt-6 border-t border-white/5 flex items-center justify-between">
                            <span class="text-primary font-bold">Photoshop</span>
                            <span class="material-symbols-outlined text-primary" data-icon="arrow_forward">arrow_forward</span>
                        </div>
                    </div>
                    <!-- Persona 2 -->
                    <div class="glass-panel p-8 rounded-xl shimmer-hover flex flex-col h-full">
                        <span class="material-symbols-outlined text-secondary mb-6 text-4xl" data-icon="print">print</span>
                        <h3 class="font-headline-md text-headline-md mb-2">Printing Shop</h3>
                        <p class="text-on-surface-variant flex-grow mb-6">Large format banners, vehicle wraps, and prepress layouts.</p>
                        <div class="pt-6 border-t border-white/5 flex items-center justify-between">
                            <span class="text-secondary font-bold">CorelDRAW</span>
                            <span class="material-symbols-outlined text-secondary" data-icon="arrow_forward">arrow_forward</span>
                        </div>
                    </div>
                    <!-- Persona 3 -->
                    <div class="glass-panel p-8 rounded-xl shimmer-hover flex flex-col h-full">
                        <span class="material-symbols-outlined text-primary mb-6 text-4xl" data-icon="ink_pen">ink_pen</span>
                        <h3 class="font-headline-md text-headline-md mb-2">Logo Designer</h3>
                        <p class="text-on-surface-variant flex-grow mb-6">Scalable brand identities and technical precision iconography.</p>
                        <div class="pt-6 border-t border-white/5 flex items-center justify-between">
                            <span class="text-secondary font-bold">CorelDRAW</span>
                            <span class="material-symbols-outlined text-secondary" data-icon="arrow_forward">arrow_forward</span>
                        </div>
                    </div>
                    <!-- Persona 4 -->
                    <div class="glass-panel p-8 rounded-xl shimmer-hover flex flex-col h-full">
                        <span class="material-symbols-outlined text-primary mb-6 text-4xl" data-icon="camera">camera</span>
                        <h3 class="font-headline-md text-headline-md mb-2">Photographer</h3>
                        <p class="text-on-surface-variant flex-grow mb-6">RAW processing, beauty retouching, and non-destructive edits.</p>
                        <div class="pt-6 border-t border-white/5 flex items-center justify-between">
                            <span class="text-primary font-bold">Photoshop</span>
                            <span class="material-symbols-outlined text-primary" data-icon="arrow_forward">arrow_forward</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Head to Head Visual Metrics -->
        <section class="py-stack-lg">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <div class="max-w-3xl mx-auto">
                    <h2 class="font-headline-lg text-headline-lg mb-stack-md text-center">Head to Head Metrics</h2>
                    
                    <!-- Metric Block -->
                    <div class="space-y-12">
                        <!-- Ease of Learning -->
                        <div class="space-y-4">
                            <div class="flex justify-between font-label-md text-label-md">
                                <span>Ease of Learning</span>
                                <span class="text-primary">Photoshop leads</span>
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-mono-sm text-outline">PS</span>
                                    <div class="h-2 flex-grow bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full bg-primary rounded-full" style="width: 85%"></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-mono-sm text-outline">CD</span>
                                    <div class="h-2 flex-grow bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full bg-secondary rounded-full" style="width: 70%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Performance -->
                        <div class="space-y-4">
                            <div class="flex justify-between font-label-md text-label-md">
                                <span>Performance (Hardware Load)</span>
                                <span class="text-secondary">CorelDRAW is lighter</span>
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-mono-sm text-outline">PS</span>
                                    <div class="h-2 flex-grow bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full bg-primary rounded-full" style="width: 65%"></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-mono-sm text-outline">CD</span>
                                    <div class="h-2 flex-grow bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full bg-secondary rounded-full" style="width: 90%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- AI Features -->
                        <div class="space-y-4">
                            <div class="flex justify-between font-label-md text-label-md">
                                <span>AI Features</span>
                                <span class="text-primary">Photoshop dominates</span>
                            </div>
                            <div class="space-y-2">
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-mono-sm text-outline">PS</span>
                                    <div class="h-2 flex-grow bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full bg-primary rounded-full" style="width: 98%"></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="w-24 text-mono-sm text-outline">CD</span>
                                    <div class="h-2 flex-grow bg-white/5 rounded-full overflow-hidden">
                                        <div class="h-full bg-secondary rounded-full" style="width: 40%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tech Soul Score -->
                        <div class="bg-primary/5 border border-primary/20 p-8 rounded-xl mt-12">
                            <div class="flex items-center justify-between mb-6">
                                <h3 class="font-headline-md text-headline-md">Tech Soul Overall Score</h3>
                                <div class="flex gap-4">
                                    <div class="text-center">
                                        <div class="text-primary font-bold text-3xl">9.4</div>
                                        <div class="text-mono-sm opacity-50 uppercase">PS</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="text-secondary font-bold text-3xl">9.1</div>
                                        <div class="text-mono-sm opacity-50 uppercase">CD</div>
                                    </div>
                                </div>
                            </div>
                            <p class="text-on-surface-variant italic">"While Photoshop wins on technological innovation and AI integration, CorelDRAW remains the superior choice for production environments and technical vector precision."</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Feature Showdown -->
        <section class="py-stack-lg bg-surface">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <h2 class="font-headline-lg text-headline-lg mb-stack-md">Feature Showdown</h2>
                <div class="space-y-4">
                    <!-- Feature 1 -->
                    <details class="glass-panel rounded-xl overflow-hidden group">
                        <summary class="flex justify-between items-center p-8 cursor-pointer hover:bg-white/5 transition-colors list-none">
                            <div class="flex items-center gap-6">
                                <span class="material-symbols-outlined text-primary text-3xl" data-icon="polyline">polyline</span>
                                <span class="font-headline-md text-headline-md">Vector Design & Management</span>
                            </div>
                            <div class="flex items-center gap-6">
                                <span class="bg-secondary/10 text-secondary px-4 py-1 rounded-full font-label-md">Winner: CorelDRAW</span>
                                <span class="material-symbols-outlined transition-transform group-open:rotate-180" data-icon="expand_more">expand_more</span>
                            </div>
                        </summary>
                        <div class="p-8 pt-0 border-t border-white/5 bg-white/2">
                            <p class="text-on-surface-variant leading-relaxed mb-4">CorelDRAW is built as a vector-first application. Its multi-page layout capabilities, superior node editing tools, and precise dimensioning make it the clear winner for technical drawing and layout design.</p>
                            <div class="grid grid-cols-2 gap-8 mt-6">
                                <div>
                                    <h4 class="font-bold mb-2">CorelDRAW Benefit</h4>
                                    <ul class="text-on-surface-variant text-sm space-y-2">
                                        <li>• Professional multi-page support</li>
                                        <li>• Advanced technical drawing tools</li>
                                        <li>• Seamless CNC and Plotter integration</li>
                                    </ul>
                                </div>
                                <div>
                                    <h4 class="font-bold mb-2">Photoshop Downside</h4>
                                    <ul class="text-on-surface-variant text-sm space-y-2">
                                        <li>• Raster-based architecture</li>
                                        <li>• Basic vector tools only</li>
                                        <li>• Harder to scale without pixelation</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </details>

                    <!-- Feature 2 -->
                    <details class="glass-panel rounded-xl overflow-hidden group">
                        <summary class="flex justify-between items-center p-8 cursor-pointer hover:bg-white/5 transition-colors list-none">
                            <div class="flex items-center gap-6">
                                <span class="material-symbols-outlined text-primary text-3xl" data-icon="auto_fix_high">auto_fix_high</span>
                                <span class="font-headline-md text-headline-md">Photo Manipulation & AI</span>
                            </div>
                            <div class="flex items-center gap-6">
                                <span class="bg-primary/10 text-primary px-4 py-1 rounded-full font-label-md">Winner: Photoshop</span>
                                <span class="material-symbols-outlined transition-transform group-open:rotate-180" data-icon="expand_more">expand_more</span>
                            </div>
                        </summary>
                        <div class="p-8 pt-0 border-t border-white/5 bg-white/2">
                            <p class="text-on-surface-variant leading-relaxed">Photoshop's Generative Fill and Firefly AI integration are lightyears ahead. For content-aware filling, complex masking, and pixel manipulation, no other software comes close.</p>
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- Real Workflows -->
        <section class="py-stack-lg">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <h2 class="font-headline-lg text-headline-lg mb-stack-md text-center">Real Workflows</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
                    <div class="glass-panel rounded-xl overflow-hidden shimmer-hover">
                        <div class="h-48 relative">
                            <img src="/images/logo_design_process.png" data-alt="A macro shot of a sleek logo design process on a high-end monitor. Soft purple lighting illuminating a clean desk setup with professional design peripherals. High-fidelity creative workspace aesthetic." class="w-full h-full object-cover">
                            <div class="absolute top-4 right-4 bg-secondary text-on-secondary px-3 py-1 rounded-full text-xs font-bold">Winner: Corel</div>
                        </div>
                        <div class="p-8">
                            <h3 class="font-headline-md text-headline-md mb-4">Creating Logos</h3>
                            <p class="text-on-surface-variant mb-6">Corel's vector engine ensures every line is mathematically perfect and infinitely scalable.</p>
                            <div class="flex items-center gap-2 text-primary font-label-md">
                                <span>See Blueprint</span>
                                <span class="material-symbols-outlined" data-icon="arrow_outward">arrow_outward</span>
                            </div>
                        </div>
                    </div>

                    <div class="glass-panel rounded-xl overflow-hidden shimmer-hover">
                        <div class="h-48 relative">
                            <img src="/images/photo_editing_session.png" data-alt="Close up of a professional photo editing session with high-contrast color grading and skin retouching. Cinematic dark studio lighting, violet and blue color palette, ultra-sharp detail." class="w-full h-full object-cover">
                            <div class="absolute top-4 right-4 bg-primary text-on-primary px-3 py-1 rounded-full text-xs font-bold">Winner: Photoshop</div>
                        </div>
                        <div class="p-8">
                            <h3 class="font-headline-md text-headline-md mb-4">Editing Photos</h3>
                            <p class="text-on-surface-variant mb-6">Non-destructive layers and neural filters make high-end retouching a breeze.</p>
                            <div class="flex items-center gap-2 text-primary font-label-md">
                                <span>See Blueprint</span>
                                <span class="material-symbols-outlined" data-icon="arrow_outward">arrow_outward</span>
                            </div>
                        </div>
                    </div>

                    <div class="glass-panel rounded-xl overflow-hidden shimmer-hover">
                        <div class="h-48 relative">
                            <img src="/images/printing_banner.png" data-alt="A wide format printer outputting a vibrant vinyl banner with intense colors and complex graphics. Industrial printing environment with soft ambient lighting and modern machinery." class="w-full h-full object-cover">
                            <div class="absolute top-4 right-4 bg-secondary text-on-secondary px-3 py-1 rounded-full text-xs font-bold">Winner: Corel</div>
                        </div>
                        <div class="p-8">
                            <h3 class="font-headline-md text-headline-md mb-4">Printing Banners</h3>
                            <p class="text-on-surface-variant mb-6">Native support for billboard-scale layouts and perfect CMYK color management.</p>
                            <div class="flex items-center gap-2 text-primary font-label-md">
                                <span>See Blueprint</span>
                                <span class="material-symbols-outlined" data-icon="arrow_outward">arrow_outward</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tech Soul Verdict -->
        <section class="py-stack-lg">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <div class="glass-panel p-12 md:p-20 rounded-xl relative overflow-hidden">
                    <div class="absolute inset-0 w-full h-full opacity-10 pointer-events-none"></div>
                    <div class="relative z-10 text-center mb-16">
                        <h2 class="font-display-lg text-display-lg-mobile md:text-display-lg mb-6">The Tech Soul Verdict</h2>
                        <p class="text-on-surface-variant text-xl max-w-3xl mx-auto">Both tools are masters of their domain. Your choice depends entirely on your output.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 relative z-10">
                        <div class="space-y-6">
                            <h3 class="font-headline-lg text-headline-lg text-primary">Choose Photoshop if...</h3>
                            <ul class="space-y-4">
                                <li class="flex gap-4">
                                    <span class="material-symbols-outlined text-primary" data-icon="check_circle">check_circle</span>
                                    <span>You work primarily with pixels, photos, and digital art.</span>
                                </li>
                                <li class="flex gap-4">
                                    <span class="material-symbols-outlined text-primary" data-icon="check_circle">check_circle</span>
                                    <span>You want the most advanced AI features on the market.</span>
                                </li>
                                <li class="flex gap-4">
                                    <span class="material-symbols-outlined text-primary" data-icon="check_circle">check_circle</span>
                                    <span>You are integrated into the Adobe Creative Cloud ecosystem.</span>
                                </li>
                            </ul>
                        </div>
                        <div class="space-y-6">
                            <h3 class="font-headline-lg text-headline-lg text-secondary">Choose CorelDRAW if...</h3>
                            <ul class="space-y-4">
                                <li class="flex gap-4">
                                    <span class="material-symbols-outlined text-secondary" data-icon="check_circle">check_circle</span>
                                    <span>You own a print shop or design for physical signage.</span>
                                </li>
                                <li class="flex gap-4">
                                    <span class="material-symbols-outlined text-secondary" data-icon="check_circle">check_circle</span>
                                    <span>You prefer a one-stop-shop for illustration and layout.</span>
                                </li>
                                <li class="flex gap-4">
                                    <span class="material-symbols-outlined text-secondary" data-icon="check_circle">check_circle</span>
                                    <span>You need specialized tools for technical drawing and CNC.</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Learning Curve -->
        <section class="py-stack-lg bg-surface-container-low">
            <div class="max-w-container-max mx-auto px-margin-desktop">
                <h2 class="font-headline-lg text-headline-lg mb-stack-md text-center">Learning Timeline</h2>
                <div class="max-w-4xl mx-auto space-y-12 py-10">
                    <div class="relative">
                        <div class="absolute h-1 w-full bg-white/5 top-1/2 -translate-y-1/2"></div>
                        <div class="flex justify-between relative z-10">
                            <div class="text-center">
                                <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-background">1</div>
                                <span class="font-bold">Beginner</span>
                                <p class="text-xs text-outline mt-1">2-4 Weeks</p>
                            </div>
                            <div class="text-center">
                                <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-background">2</div>
                                <span class="font-bold">Intermediate</span>
                                <p class="text-xs text-outline mt-1">3-6 Months</p>
                            </div>
                            <div class="text-center">
                                <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-4 border-4 border-background">3</div>
                                <span class="font-bold">Professional</span>
                                <p class="text-xs text-outline mt-1">1-2 Years</p>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-on-surface-variant">
                        <div class="p-6 bg-surface/50 rounded-xl">
                            <h4 class="font-bold text-primary mb-2">Photoshop Curve</h4>
                            <p class="text-sm">Steeper initial curve due to layer logic and vast menu system. Mastery takes longer but rewards with infinite flexibility.</p>
                        </div>
                        <div class="p-6 bg-surface/50 rounded-xl">
                            <h4 class="font-bold text-secondary mb-2">CorelDRAW Curve</h4>
