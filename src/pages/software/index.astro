---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Software Directory - Tech Soul" description="Discover trusted software for design, productivity, development, business, and more.">

<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 bg-surface/70 backdrop-blur-xl dark:bg-surface/70 border-b border-white/5 shadow-primary/20 shadow-2xl">
  <div class="flex justify-between items-center h-20 px-gutter max-w-container-max mx-auto">
    <div class="flex items-center gap-8">
      <a class="font-headline-md text-headline-md font-bold text-on-surface tracking-tight hover:text-primary transition-colors duration-300" href="/">Tech Soul</a>
      <div class="hidden md:flex gap-6 items-center">
        <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="/">Discover</a>
        <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="#">Industries</a>
        <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="/blueprint">Blueprints</a>
        <a class="font-label-md text-label-md text-primary font-bold border-b-2 border-primary pb-1 scale-95 transition-transform duration-200" href="/software">Software</a>
        <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="#">AI Tools</a>
        <a class="font-label-md text-label-md text-on-surface-variant font-medium hover:text-primary transition-colors duration-300" href="#">Resources</a>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <button class="text-on-surface hover:text-primary transition-colors duration-300">
        <span class="material-symbols-outlined" data-icon="search">search</span>
      </button>
      <button class="hidden md:block bg-gradient-to-r from-primary-container to-secondary-container text-white font-label-md text-label-md px-6 py-2 rounded-lg font-bold hover:brightness-110 transition-all shadow-[0_0_15px_rgba(124,58,237,0.3)]">Compare</button>
    </div>
  </div>
</nav>

<main class="flex-grow pt-32 pb-margin-desktop">
  <!-- Hero Section -->
  <section class="max-w-container-max mx-auto px-gutter mb-stack-lg text-center mt-12 relative">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary-container/20 via-background to-background"></div>
    <h1 class="font-display-lg text-display-lg md:font-display-lg md:text-display-lg mb-6">Explore <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">Software</span></h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto mb-10">Discover trusted software for design, productivity, development, business, and more. Find the perfect tools to elevate your workflow.</p>
    <div class="max-w-3xl mx-auto relative group">
      <div class="absolute inset-0 bg-primary-container/20 rounded-xl blur-xl group-hover:bg-primary-container/30 transition-colors duration-500"></div>
      <div class="relative glass-panel rounded-xl p-2 flex items-center">
        <span class="material-symbols-outlined text-outline ml-4 mr-3" data-icon="search">search</span>
        <input class="w-full bg-transparent border-none text-on-surface font-body-lg text-body-lg focus:ring-0 placeholder-outline focus:outline-none py-3" placeholder="Search software, categories, or use cases..." type="text">
        <button class="bg-primary-container text-white px-8 py-3 rounded-lg font-bold hover:bg-primary-container/90 transition-colors">Search</button>
      </div>
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <span class="font-mono-sm text-mono-sm text-outline-variant mr-2 mt-2">Suggested:</span>
      <button class="bg-surface-variant/50 hover:bg-surface-variant text-on-surface-variant hover:text-primary font-mono-sm text-mono-sm px-4 py-2 rounded-full border border-white/5 transition-all">Photoshop</button>
      <button class="bg-surface-variant/50 hover:bg-surface-variant text-on-surface-variant hover:text-primary font-mono-sm text-mono-sm px-4 py-2 rounded-full border border-white/5 transition-all">Canva</button>
      <button class="bg-surface-variant/50 hover:bg-surface-variant text-on-surface-variant hover:text-primary font-mono-sm text-mono-sm px-4 py-2 rounded-full border border-white/5 transition-all">Figma</button>
      <button class="bg-surface-variant/50 hover:bg-surface-variant text-on-surface-variant hover:text-primary font-mono-sm text-mono-sm px-4 py-2 rounded-full border border-white/5 transition-all">CorelDRAW</button>
      <button class="bg-surface-variant/50 hover:bg-surface-variant text-on-surface-variant hover:text-primary font-mono-sm text-mono-sm px-4 py-2 rounded-full border border-white/5 transition-all">Premiere Pro</button>
    </div>
  </section>

  <!-- Category Explorer -->
  <section class="max-w-container-max mx-auto px-gutter mb-stack-lg">
    <h2 class="font-headline-lg text-headline-lg mb-8">Browse by category</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Creative & Design -->
      <a class="bg-gradient-to-br from-surface via-surface to-surface-container-highest relative overflow-hidden border border-white/10 rounded-xl p-6 hover:scale-[1.02] hover:border-primary/50 transition-all duration-300 group" href="/software/creative-design">
        <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl transition-all group-hover:bg-primary/20"></div>
        <div class="absolute -left-10 -bottom-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl transition-all group-hover:bg-secondary/20"></div>
        <div class="w-12 h-12 rounded-xl bg-surface-container-highest/50 backdrop-blur border border-white/5 flex items-center justify-center mb-4 relative z-10 group-hover:bg-primary/10 transition-colors">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="9" cy="9" fill="url(#grad1)" opacity="0.8" r="6"></circle>
            <rect fill="url(#grad2)" height="10" opacity="0.8" rx="3" width="10" x="9" y="9"></rect>
            <defs>
              <linearGradient id="grad1" x1="3" x2="15" y1="3" y2="15"><stop stop-color="#d2bbff"></stop><stop offset="1" stop-color="#7c3aed" stop-opacity="0.5"></stop></linearGradient>
              <linearGradient id="grad2" x1="9" x2="19" y1="9" y2="19"><stop stop-color="#4cd7f6"></stop><stop offset="1" stop-color="#03b5d3" stop-opacity="0.5"></stop></linearGradient>
            </defs>
          </svg>
        </div>
        <h3 class="font-headline-md text-headline-md mb-2 text-lg relative z-10">Creative &amp; Design</h3>
        <p class="font-body-md text-body-md text-on-surface-variant text-sm mb-4 relative z-10">Tools for visual artists and designers.</p>
        <p class="font-mono-sm text-mono-sm text-outline relative z-10">120+ items</p>
      </a>
      <!-- Video & Audio -->
      <a class="bg-gradient-to-br from-surface via-surface to-surface-container-highest relative overflow-hidden border border-white/10 rounded-xl p-6 hover:scale-[1.02] hover:border-primary/50 transition-all duration-300 group" href="#">
        <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl transition-all group-hover:bg-primary/20"></div>
        <div class="absolute -left-10 -bottom-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl transition-all group-hover:bg-secondary/20"></div>
        <div class="w-12 h-12 rounded-xl bg-surface-container-highest/50 backdrop-blur border border-white/5 flex items-center justify-center mb-4 relative z-10 group-hover:bg-primary/10 transition-colors">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <polygon fill="url(#grad3)" opacity="0.9" points="6,4 20,12 6,20"></polygon>
            <circle cx="16" cy="16" fill="url(#grad4)" opacity="0.7" r="5"></circle>
            <defs>
              <linearGradient id="grad3" x1="6" x2="20" y1="4" y2="20"><stop stop-color="#d2bbff"></stop><stop offset="1" stop-color="#7c3aed" stop-opacity="0.2"></stop></linearGradient>
              <linearGradient id="grad4" x1="11" x2="21" y1="11" y2="21"><stop stop-color="#4cd7f6"></stop><stop offset="1" stop-color="#03b5d3" stop-opacity="0.8"></stop></linearGradient>
            </defs>
          </svg>
        </div>
        <h3 class="font-headline-md text-headline-md mb-2 text-lg relative z-10">Video &amp; Audio</h3>
        <p class="font-body-md text-body-md text-on-surface-variant text-sm mb-4 relative z-10">Editing and production software.</p>
        <p class="font-mono-sm text-mono-sm text-outline relative z-10">85 items</p>
      </a>
      <!-- Productivity -->
      <a class="bg-gradient-to-br from-surface via-surface to-surface-container-highest relative overflow-hidden border border-white/10 rounded-xl p-6 hover:scale-[1.02] hover:border-primary/50 transition-all duration-300 group" href="#">
        <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl transition-all group-hover:bg-primary/20"></div>
        <div class="absolute -left-10 -bottom-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl transition-all group-hover:bg-secondary/20"></div>
        <div class="w-12 h-12 rounded-xl bg-surface-container-highest/50 backdrop-blur border border-white/5 flex items-center justify-center mb-4 relative z-10 group-hover:bg-primary/10 transition-colors">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect fill="url(#grad5)" height="10" rx="1" width="6" x="4" y="10"></rect>
            <rect fill="url(#grad6)" height="16" rx="1" width="6" x="14" y="4"></rect>
            <circle cx="10" cy="7" fill="#d2bbff" opacity="0.6" r="3"></circle>
            <defs>
              <linearGradient id="grad5" x1="4" x2="10" y1="10" y2="20"><stop stop-color="#4cd7f6"></stop><stop offset="1" stop-color="#03b5d3" stop-opacity="0.4"></stop></linearGradient>
              <linearGradient id="grad6" x1="14" x2="20" y1="4" y2="20"><stop stop-color="#d2bbff"></stop><stop offset="1" stop-color="#7c3aed"></stop></linearGradient>
            </defs>
          </svg>
        </div>
        <h3 class="font-headline-md text-headline-md mb-2 text-lg relative z-10">Productivity</h3>
        <p class="font-body-md text-body-md text-on-surface-variant text-sm mb-4 relative z-10">Task management and office suites.</p>
        <p class="font-mono-sm text-mono-sm text-outline relative z-10">200+ items</p>
      </a>
      <!-- Development -->
      <a class="bg-gradient-to-br from-surface via-surface to-surface-container-highest relative overflow-hidden border border-white/10 rounded-xl p-6 hover:scale-[1.02] hover:border-primary/50 transition-all duration-300 group" href="#">
        <div class="absolute -right-10 -top-10 w-32 h-32 bg-primary/10 rounded-full blur-2xl transition-all group-hover:bg-primary/20"></div>
        <div class="absolute -left-10 -bottom-10 w-32 h-32 bg-secondary/10 rounded-full blur-2xl transition-all group-hover:bg-secondary/20"></div>
        <div class="w-12 h-12 rounded-xl bg-surface-container-highest/50 backdrop-blur border border-white/5 flex items-center justify-center mb-4 relative z-10 group-hover:bg-primary/10 transition-colors">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3L21 8.2V15.8L12 21L3 15.8V8.2L12 3Z" fill="url(#grad7)" opacity="0.5" stroke="#d2bbff" stroke-width="1"></path>
            <circle cx="12" cy="12" fill="url(#grad8)" r="4"></circle>
            <defs>
              <linearGradient id="grad7" x1="3" x2="21" y1="3" y2="21"><stop stop-color="#4cd7f6"></stop><stop offset="1" stop-color="#03b5d3" stop-opacity="0.1"></stop></linearGradient>
              <linearGradient id="grad8" x1="8" x2="16" y1="8" y2="16"><stop stop-color="#d2bbff"></stop><stop offset="1" stop-color="#7c3aed"></stop></linearGradient>
            </defs>
          </svg>
        </div>
        <h3 class="font-headline-md text-headline-md mb-2 text-lg relative z-10">Development</h3>
        <p class="font-body-md text-body-md text-on-surface-variant text-sm mb-4 relative z-10">IDEs, databases, and DevOps tools.</p>
        <p class="font-mono-sm text-mono-sm text-outline relative z-10">150+ items</p>
      </a>
    </div>
  </section>
</main>

<!-- Footer -->
<footer class="bg-surface-container-lowest dark:bg-surface-container-lowest w-full py-stack-lg border-t border-white/5">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-stack-md px-gutter max-w-container-max mx-auto">
    <div class="col-span-1 md:col-span-1">
      <div class="font-headline-md text-headline-md font-bold text-on-surface mb-4">Tech Soul</div>
      <p class="font-body-md text-body-md text-outline">© 2024 Tech Soul. Premium Software Discovery.</p>
    </div>
    <div>
      <ul class="space-y-3 font-body-md text-body-md">
        <li><a class="text-outline hover:text-secondary transition-colors" href="/software">Software</a></li>
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">Categories</a></li>
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">Compare</a></li>
      </ul>
    </div>
    <div>
      <ul class="space-y-3 font-body-md text-body-md">
        <li><a class="text-outline hover:text-secondary transition-colors" href="/blueprint">Blueprints</a></li>
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">Resources</a></li>
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">About</a></li>
      </ul>
    </div>
    <div>
      <ul class="space-y-3 font-body-md text-body-md">
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">Contact</a></li>
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">Privacy Policy</a></li>
        <li><a class="text-outline hover:text-secondary transition-colors" href="#">Terms of Service</a></li>
      </ul>
    </div>
  </div>
</footer>

</Layout>
